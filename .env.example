# ===================================================
# Telegraph - Variables de Entorno del Sistema
# ===================================================

# Django Core
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=telegraph-super-secret-key-change-this-for-production-environment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Base de Datos PostgreSQL
POSTGRES_DB=telegraph_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis & WebSockets Channels
REDIS_HOST=redis
REDIS_PORT=6379
CHANNEL_BACKEND=redis

# Clave Simétrica Fernet para Cifrado de Secretos Efímeros
